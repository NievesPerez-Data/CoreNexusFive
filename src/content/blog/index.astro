---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import FormattedDate from '@/components/FormattedDate.astro';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<Layout title="Documentación Técnica | Core Nexus Five" description="Guía paso a paso del despliegue de Core Nexus Five en AWS.">
  <section class="w-full flex flex-col items-center px-4 py-16">
    <h1 class="text-5xl md:text-6xl font-fugaz font-bold uppercase text-center mb-16">
      Documentación Técnica
    </h1>

    <div class="w-full max-w-3xl flex flex-col gap-6">
      {posts.map((post) => (
        <a
          href={`${base}blog/${post.slug}`}
          class="block border border-black/10 hover:border-black transition-colors p-6"
        >
          <p class="text-xs uppercase tracking-wide text-gray-500 mb-2">
            <FormattedDate date={new Date(post.data.pubDate)} />
          </p>
          <h2 class="text-xl md:text-2xl font-fugaz font-bold uppercase mb-2">
            {post.data.title}
          </h2>
          <p class="text-base text-gray-700">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
