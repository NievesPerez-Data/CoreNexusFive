---
import Layout from "../../layouts/Layout.astro";

/*
 * Carga automáticamente todas las publicaciones MDX
 * que estén dentro de:
 *
 * src/content/blog/
 */
const posts = import.meta.glob(
  "../../content/blog/*.mdx",
  {
    eager: true,
    import: "default",
  },
);

/*
 * Generamos una página para cada archivo .mdx
 *
 * Ejemplo:
 *
 * creacion-buckets-s3.mdx
 *
 * se convierte en:
 *
 * /blog/creacion-buckets-s3/
 */
export function getStaticPaths() {
  return Object.entries(posts).map(
    ([filePath, component]) => {
      const fileName =
        filePath.split("/").pop() ?? "";

      const slug = fileName.replace(
        /\.mdx$/,
        "",
      );

      return {
        params: {
          slug,
        },
        props: {
          component,
        },
      };
    },
  );
}

const {
  component: Post,
} = Astro.props;
---

<Layout
  title="Blog | Core Nexus Five"
  description="Proceso de construcción de la arquitectura de datos en AWS."
>
  <main class="blog-page">

    <article class="blog-article">
      <Post />
    </article>

  </main>
</Layout>

<style>
  .blog-page {
    width: 100%;
    min-height: 100vh;
    background: #f7f6f3;
    padding: 80px 24px 100px;
  }

  .blog-article {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    color: #141312;
  }

  .blog-article :global(h1) {
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.05;
    margin-bottom: 30px;
    font-weight: 700;
  }

  .blog-article :global(h2) {
    font-size: 2rem;
    margin-top: 55px;
    margin-bottom: 20px;
  }

  .blog-article :global(h3) {
    font-size: 1.4rem;
    margin-top: 35px;
    margin-bottom: 15px;
  }

  .blog-article :global(p) {
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 22px;
  }

  .blog-article :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 35px auto;
    border-radius: 8px;
  }

  .blog-article :global(pre) {
    overflow-x: auto;
    padding: 20px;
    border-radius: 8px;
    background: #111;
    color: #f5f5f5;
    margin: 30px 0;
  }

  .blog-article :global(code) {
    font-family: monospace;
  }

  .blog-article :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .blog-article :global(ul),
  .blog-article :global(ol) {
    margin: 20px 0 30px 25px;
    line-height: 1.8;
  }

  .blog-article :global(blockquote) {
    border-left: 4px solid #141312;
    padding-left: 20px;
    margin: 30px 0;
    font-style: italic;
  }
</style>
