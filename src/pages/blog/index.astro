---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("blog");

const sortedPosts = posts.sort(
  (a, b) =>
    b.data.pubDate.getTime() -
    a.data.pubDate.getTime(),
);
---

<Layout
  title="Documentación Técnica | Core Nexus Five"
  description="Documentación técnica del proyecto Core Nexus Five y del proceso de construcción del pipeline de datos en AWS."
>
  <main class="documentation">

    <section class="documentation-header">

      <p class="eyebrow">
        CORE NEXUS FIVE · AWS
      </p>

      <h1>
        Documentación Técnica
      </h1>

      <p class="intro">
        Registro del proceso de construcción de la arquitectura
        de datos, desde la infraestructura inicial hasta el
        procesamiento y análisis de la información.
      </p>

    </section>

    <section class="documentation-list">

      {
        sortedPosts.map((post, index) => (
          <a
            href={`/CoreNexusFive/blog/${post.id}/`}
            class="documentation-item"
          >

            <div class="documentation-number">
              {String(index + 1).padStart(2, "0")}
            </div>

            <div class="documentation-info">

              <p class="documentation-category">
                FASE {index + 1}
              </p>

              <h2>
                {post.data.title}
              </h2>

              <p class="documentation-description">
                {post.data.description}
              </p>

            </div>

            <div class="documentation-arrow">
              →
            </div>

          </a>
        ))
      }

    </section>

  </main>
</Layout>

<style>
  .documentation {
    width: 100%;
    min-height: 100vh;
    background: #f7f6f3;
    padding: 110px 24px 120px;
  }

  .documentation-header {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto 80px;
  }

  .eyebrow {
    margin: 0 0 20px;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    font-weight: 700;
    color: #777;
  }

  .documentation-header h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.9;
    text-transform: uppercase;
    font-weight: 800;
    font-style: italic;
  }

  .intro {
    max-width: 700px;
    margin-top: 35px;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #555;
  }

  .documentation-list {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    border-top: 1px solid #ccc;
  }

  .documentation-item {
    display: grid;
    grid-template-columns: 80px 1fr 50px;
    align-items: center;
    gap: 30px;
    padding: 35px 0;
    border-bottom: 1px solid #ccc;
    color: #111;
    text-decoration: none;
    transition: padding 0.25s ease;
  }

  .documentation-item:hover {
    padding-left: 15px;
    padding-right: 15px;
  }

  .documentation-number {
    font-size: 0.9rem;
    font-weight: 700;
    color: #888;
  }

  .documentation-category {
    margin: 0 0 8px;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    font-weight: 700;
    color: #888;
  }

  .documentation-info h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
    font-style: italic;
  }

  .documentation-description {
    max-width: 650px;
    margin: 12px 0 0;
    color: #666;
    line-height: 1.6;
  }

  .documentation-arrow {
    font-size: 1.8rem;
    text-align: right;
  }

  @media (max-width: 700px) {

    .documentation {
      padding: 80px 20px;
    }

    .documentation-item {
      grid-template-columns: 45px 1fr 25px;
      gap: 15px;
    }

    .documentation-info h2 {
      font-size: 1.35rem;
    }

    .documentation-description {
      font-size: 0.9rem;
    }
  }
</style>
