---
import Layout from "@/layouts/Layout.astro";
import HomeMob from "@/components/HomeMob.astro";
import VerticalCarousel from "@/components/react/VerticalCarousel";

const base = import.meta.env.BASE_URL;
---

<Layout>

  <!-- IMAGEN-ENLACE AL BLOG (prueba con una de las fotos de Arquitectura) -->
  <a href={`${base}blog/creacion-buckets-s3`} class="blog-teaser">
    <img src={`${base}Atenea.jpg`} alt="Fase 1: Creación de Buckets S3" class="blog-teaser-img" />
    <div class="blog-teaser-overlay">
      <span class="blog-teaser-kicker">Blog · Fase 1</span>
      <span class="blog-teaser-title">Creación de Buckets S3</span>
    </div>
  </a>

  <div class="md:flex-row flex flex-col md:gap-10 relative md:pr-72 grow">

    <div class="relative hidden md:flex flex-1">
      
      <h2 class="max-w-96 text-9xl absolute text-center z-20 -right-32 bottom-1/3 font-fugaz uppercase leading-[0.8]">
        Core Nexus Five
      </h2>

      <p class="text-xl absolute bottom-1/4 right-0 z-20 font-bold uppercase tracking-tight">
        Proyecto Final AWS Re/Start
      </p>

      <p class="text-lg absolute bottom-[20%] right-0 z-20 italic font-light">
        Nexo entre infraestructura y analítica de datos.
      </p>

      <a 
        href="https://nievesperez-data.github.io/" 
        class="text-xl absolute bottom-[15%] right-0 z-20 border-b-2 border-black pb-1"
      >
        Nieves Pérez
      </a>

    </div>

    <HomeMob />

    <div class="min-h-screen md:w-1/2 -mt-50 md:mt-0 max-h-full overflow-hidden">
      <VerticalCarousel client:visible imageCount={10} />
    </div>

  </div>
</Layout>

<style>
  .blog-teaser {
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    height: 260px;
    overflow: hidden;
    border: 2px solid #000000;
    box-shadow: 10px 10px 0px rgba(0, 0, 0, 0.08);
    margin-bottom: 32px;
    text-decoration: none;
  }

  .blog-teaser-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  .blog-teaser:hover .blog-teaser-img {
    transform: scale(1.04);
    filter: grayscale(0.4) contrast(1.05);
  }

  .blog-teaser-overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 18px 22px 20px;
    background: linear-gradient(to top, rgba(0,0,0,0.65), transparent);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .blog-teaser-kicker {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
  }

  .blog-teaser-title {
    font-family: 'Fugaz One', cursive;
    font-size: 24px;
    text-transform: uppercase;
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .blog-teaser { height: 190px; }
    .blog-teaser-title { font-size: 19px; }
  }
</style>
