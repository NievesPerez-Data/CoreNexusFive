---
import Layout from "../layouts/Layout.astro";
import AteneaImg from "../../public/Atenea.jpg";
import ZeusImg from "../../public/Zeus.png";
import ArgosImg from "../../public/Argos.jpg";
import GaiaImg from "../../public/Gaia.jpg";
import CerberoImg from "../../public/Cerbero.jpg";
import PandoraImg from "../../public/Pandora.jpg";
import HermesImg from "../../public/Hermes.jpg";
import EfestoImg from "../../public/Hefesto.jpg";
---

<Layout
  title="Arquitectura | Core Nexus Five"
  description="Mapa conceptual interactivo de la arquitectura de datos en AWS: S3, Glue, Athena y más."
  pubDate={new Date("May 16 2026")}
  heroImage="/blog-placeholder-about.jpg"
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;700;800&family=Fugaz+One&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <section class="architecture-wrapper">

<!-- ARCHIVO HTML SUPERIOR -->
   <div class="top-video-container" style="max-width: 1080px; margin: 0 auto 48px auto; width: 100%; height: 550px;">
  <iframe
    src={`${import.meta.env.BASE_URL}assets/ochoretratos.html`}
    title="Animación HTML"
    style="width: 100%; height: 100%; border: none; border-radius: 8px;"
    loading="eager"
  ></iframe>
</div>

    <!-- INTRO: EL OLIMPO DE LOS DATOS -->
    <div class="intro">
      <h2 class="intro-main-title">El Olimpo de los Datos</h2>
      <p class="intro-subtitle">
        Este mapa conceptual interactivo desarma la arquitectura desde su base para comprender su lógica.
      </p>
      <div class="cta-row">
        <p class="intro-cta">
          ↗ Pasa el cursor sobre las imágenes para revelar la información.
        </p>
        <svg class="marker-arrow" viewBox="0 0 120 80">
          <path d="M-20,40 Q30,35 110,40" stroke="currentColor" stroke-width="7" fill="none" stroke-linecap="round"/>
          <path d="M80,18 L112,41 L80,63" stroke="currentColor" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="cta-handwritten">Pop up</span>
      </div>
      <div class="intro-analogy">
        <span class="intro-analogy-title">¿Por qué la analogía clásica?</span>
        <p class="intro-analogy-body">La infraestructura de AWS opera sobre abstracciones complejas de red, computación y almacenamiento de datos. Esta capa conceptual basada en la Grecia Clásica no es decoración, sino un modelo mental unificado. Al asociar servicios de la nube con arquetipos universales, aceleramos la comprensión de la arquitectura, humanizamos los flujos de datos y transformamos la documentación técnica en narrativa lógica y visual.</p>
      </div>
    </div>

    <!-- LÍNEA DE TIEMPO -->
    <div class="timeline">
      <div class="t-item minor">
        <div class="t-label top"><span class="n">01.</span> Lambda</div>
        <div class="t-dot"></div>
        <div class="t-label bottom empty">—</div>
      </div>
      <div class="t-item major">
        <div class="t-label top empty">—</div>
        <div class="t-dot"></div>
        <div class="t-label bottom"><span class="n">02.</span> S3</div>
      </div>
      <div class="t-item minor">
        <div class="t-label top"><span class="n">03.</span> IAM</div>
        <div class="t-dot"></div>
        <div class="t-label bottom empty">—</div>
      </div>
      <div class="t-item major">
        <div class="t-label top empty">—</div>
        <div class="t-dot"></div>
        <div class="t-label bottom"><span class="n">04.</span> Buckets</div>
      </div>
      <div class="t-item minor">
        <div class="t-label top"><span class="n">05.</span> Crawlers</div>
        <div class="t-dot"></div>
        <div class="t-label bottom empty">—</div>
      </div>
      <div class="t-item major">
        <div class="t-label top empty">—</div>
        <div class="t-dot"></div>
        <div class="t-label bottom"><span class="n">06.</span> Glue</div>
      </div>
      <div class="t-item major">
        <div class="t-label top"><span class="n">07.</span> Athena</div>
        <div class="t-dot"></div>
        <div class="t-label bottom empty">—</div>
      </div>
      <div class="t-item major">
        <div class="t-label top empty">—</div>
        <div class="t-dot"></div>
        <div class="t-label bottom"><span class="n">08.</span> Demo</div>
      </div>
    </div>

    <!-- CUADRÍCULA DE NODOS -->
    <div class="grid-nodes">

      <div class="card secondary" data-align="right" data-shape="vert">
        <div class="photo">
          <img src={ZeusImg.src} alt="Lambda" class="field-img" />
          <div class="grain"></div>
          <div class="tag"><span class="rule"></span><span class="num">01</span><span class="label">Lambda</span></div>
          <div class="window"><img src={ZeusImg.src} alt="" class="sharp-img" /></div>
          <div class="info">
            <span class="deity">Zeus</span>
            <span class="badge">AWS LAMBDA</span>
            <p>Cómputo serverless que lanza código de forma reactiva bajo demanda.</p>
          </div>
        </div>
      </div>

      <div class="card" data-shape="horiz">
        <div class="photo">
          <img src={GaiaImg.src} alt="S3" class="field-img" />
          <div class="grain"></div>
          <div class="tag"><span class="rule"></span><span class="num">02</span><span class="label">S3</span></div>
          <div class="window"><img src={GaiaImg.src} alt="" class="sharp-img" /></div>
          <div class="info">
            <span class="deity">Gaia</span>
            <span class="badge">AWS S3</span>
            <p>Raíz primordial del almacenamiento, donde se origina todo el ecosistema.</p>
          </div>
        </div>
      </div>

      <div class="card secondary" data-align="left" data-shape="vert">
        <div class="photo">
          <img src={CerberoImg.src} alt="IAM" class="field-img" />
          <div class="grain"></div>
          <div class="tag"><span class="rule"></span><span class="num">03</span><span class="label">IAM</span></div>
          <div class="window"><img src={CerberoImg.src} alt="" class="sharp-img" /></div>
          <div class="info">
            <span class="deity">Cerbero</span>
            <span class="badge">AWS IAM</span>
            <p>Custodia y gestiona los accesos de seguridad de todo el ecosistema.</p>
          </div>
        </div>
      </div>

      <div class="card" data-shape="horiz">
        <div class="photo">
          <img src={PandoraImg.src} alt="Buckets" class="field-img" />
          <div class="grain"></div>
          <div class="tag"><span class="rule"></span><span class="num">04</span><span class="label">Buckets</span></div>
          <div class="window"><img src={PandoraImg.src} alt="" class="sharp-img" /></div>
          <div class="info">
            <span class="deity">Pandora</span>
            <span class="badge">S3 BUCKETS</span>
            <p>Contenedores de datos específicos. Bien custodiados, albergan valor.</p>
          </div>
        </div>
      </div>

      <div class="card secondary" data-align="right" data-shape="vert">
        <div class="photo">
          <img src={ArgosImg.src} alt="Crawlers" class="field-img" />
          <div class="grain"></div>
          <div class="tag"><span class="rule"></span><span class="num">05</span><span class="label">Crawlers</span></div>
          <div class="window"><img src={ArgosImg.src} alt="" class="sharp-img" /></div>
          <div class="info">
            <span class="deity">Argos</span>
            <span class="badge">GLUE CRAWLERS</span>
            <p>Explora las fuentes de datos mapeando sus metadatos ocultos.</p>
          </div>
        </div>
      </div>

      <div class="card" data-shape="horiz">
        <div class="photo">
          <img src={HermesImg.src} alt="Glue" class="field-img" />
          <div class="grain"></div>
          <div class="tag"><span class="rule"></span><span class="num">06</span><span class="label">Glue</span></div>
          <div class="window"><img src={HermesImg.src} alt="" class="sharp-img" /></div>
          <div class="info">
            <span class="deity">Hermes</span>
            <span class="badge">AWS GLUE</span>
            <p>Orquestador ETL que transforma y mensajea los flujos de datos entre capas.</p>
          </div>
        </div>
      </div>

      <div class="card" data-shape="vert">
        <div class="photo">
          <img src={AteneaImg.src} alt="Athena" class="field-img" />
          <div class="grain"></div>
          <div class="tag"><span class="rule"></span><span class="num">07</span><span class="label">Athena</span></div>
          <div class="window"><img src={AteneaImg.src} alt="" class="sharp-img" /></div>
          <div class="info">
            <span class="deity">Atenea</span>
            <span class="badge">AWS ATHENA</span>
            <p>Motor de análisis que ejecuta consultas SQL directas sobre S3.</p>
          </div>
        </div>
      </div>

      <div class="card" data-shape="horiz">
        <div class="photo">
          <img src={EfestoImg.src} alt="Demo" class="field-img" />
          <div class="grain"></div>
          <div class="tag"><span class="rule"></span><span class="num">08</span><span class="label">Demo</span></div>
          <div class="window"><img src={EfestoImg.src} alt="" class="sharp-img" /></div>
          <div class="info">
            <span class="deity">Efesto</span>
            <span class="badge">DEMO APP</span>
            <p>La forja donde confluyen los flujos de datos en su interfaz funcional.</p>
          </div>
        </div>
      </div>

    </div>

  </section>

</Layout>

<style>
  :root {
    --bg: #f7f6f3;
    --line: rgba(17,17,17,0.14);
    --on-photo: #f5f4f0;
    --window-line: rgba(245,244,240,0.5);
    --ink: #141312;
    --ink-muted: #6b6862;
    --badge: #2c2a27;
  }

  * { box-sizing: border-box; }

  .architecture-wrapper {
    width: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
    padding: 64px 28px 90px;
  }

  .intro,
  .timeline,
  .grid-nodes {
    max-width: 1080px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ---- INTRO: EL OLIMPO DE LOS DATOS (sin marco, integrada al fondo) ---- */
  .intro {
    padding: 0 0 28px;
    margin: 0 auto 48px;
    max-width: 720px;
  }

  .intro-main-title {
    font-family: 'Fugaz One', cursive;
    font-weight: 400;
    text-transform: uppercase;
    font-size: 48px;
    color: var(--ink);
    letter-spacing: 0.5px;
    margin: 0 0 18px 0;
    line-height: 1.1;
    text-align: left;
  }

  .intro-subtitle {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0 0 18px 40px;
    max-width: 540px;
  }

  .intro-cta {
    font-family: 'Caveat', cursive;
    font-size: 27px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
    margin: 0;
    max-width: 460px;
    padding: 13px 16px;
    border: 1px solid var(--line);
    background: rgba(20,19,18,0.03);
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0 0 26px 40px;
    flex-wrap: wrap;
  }

  .marker-arrow {
    width: 60px;
    flex-shrink: 0;
    overflow: visible;
    color: var(--ink);
  }

  .cta-handwritten {
    font-family: 'Caveat', cursive;
    font-size: 30px;
    font-weight: 700;
    color: var(--ink);
    line-height: 0.9;
    transform: rotate(-1deg);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .cta-row { flex-direction: column; align-items: flex-start; gap: 6px; }
    .marker-arrow { display: none; }
  }

  .intro-analogy {
    border-top: 1px solid var(--line);
    padding-top: 20px;
    margin-left: 40px;
  }

  .intro-analogy-title {
    font-family: 'Fugaz One', cursive;
    font-weight: 400;
    text-transform: uppercase;
    font-size: 28px;
    color: var(--ink);
    display: block;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  .intro-analogy-body {
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink-muted);
    margin: 0;
    max-width: 600px;
  }

  /* ---- LÍNEA DE TIEMPO ---- */
  .timeline {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 150px;
    margin-bottom: 56px;
    padding: 0 6px;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 50%;
    height: 1px;
    background: var(--line);
    transform: translateY(-50%);
    z-index: 0;
  }

  .t-item {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 1px;
  }

  .t-label {
    font-size: 11px;
    line-height: 1.5;
    white-space: nowrap;
    color: var(--ink-muted);
  }
  .t-label .n { color: var(--ink); font-weight: 500; }
  .t-label.top    { margin-bottom: 14px; }
  .t-label.bottom { margin-top: 14px; }
  .t-label.empty  { visibility: hidden; }

  .t-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--ink);
    flex-shrink: 0;
  }
  .t-item.major .t-dot { width: 14px; height: 14px; }
  .t-item.minor .t-dot { width: 6px; height: 6px; background: var(--ink-muted); }

  @media (max-width: 760px) { .timeline { display: none; } }

  /* ---- CUADRÍCULA DE NODOS (izquierda→derecha, arriba→abajo) ---- */
  .grid-nodes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    align-items: start;
  }
  @media (max-width: 900px) { .grid-nodes { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid-nodes { grid-template-columns: 1fr; } }

  .card {
    border: 1px solid var(--line);
    position: relative;
    cursor: pointer;
  }

  .card[data-shape="vert"]  { aspect-ratio: 3 / 4.4; }
  .card[data-shape="horiz"] { aspect-ratio: 4 / 3; }

  /* servicios secundarios: más pequeños, para romper la retícula */
  .card.secondary { width: 66%; }
  .card.secondary[data-align="left"]  { margin-right: auto; }
  .card.secondary[data-align="right"] { margin-left: auto; }

  .photo { position: relative; width: 100%; height: 100%; overflow: hidden; background: #0e0d0c; }

  .field-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter 0.5s ease, transform 0.5s ease;
  }
  .card:hover .field-img {
    filter: grayscale(1) contrast(1.05) blur(7px) brightness(0.55);
    transform: scale(1.06);
  }

  .grain {
    position: absolute; inset: 0;
    background: repeating-radial-gradient(circle at 30% 20%, rgba(255,255,255,0.025) 0 1px, transparent 1px 2px);
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  /* recuadro nítido: línea fina y sutil, sin halo */
  .window {
    position: absolute;
    top: 14%; left: 10%;
    width: 46%; height: 60%;
    border: 1px solid var(--window-line);
    overflow: hidden;
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 0.35s ease 0.05s, transform 0.35s ease 0.05s;
  }
  .card:hover .window { opacity: 1; transform: scale(1); }

  .sharp-img {
    position: absolute;
    top: -25%; left: -25%;
    width: 150%; height: 150%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.2);
  }

  /* numeración llamativa, siempre visible, con línea ilustrativa arriba */
  .tag {
    position: absolute;
    top: 18px; left: 18px;
    z-index: 4;
    color: var(--on-photo);
  }
  .tag .rule { display:block; width: 22px; height: 1px; background: var(--on-photo); margin-bottom: 8px; }
  .tag .num { display:block; font-size: 30px; font-weight: 600; line-height: 1; letter-spacing: -0.02em; }
  .tag .label { display:block; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(245,244,240,0.7); margin-top: 4px; }

  .info {
    position: absolute;
    left: 60%;
    right: 8%;
    top: 16%;
    text-align: left;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s ease 0.08s, transform 0.35s ease 0.08s;
    z-index: 3;
  }
  .card:hover .info { opacity: 1; transform: translateY(0); }

  .info .deity {
    font-family: 'Caveat', cursive;
    font-size: 28px;
    font-weight: 700;
    color: var(--on-photo);
    display: block;
    line-height: 1;
  }
  .info .badge {
    display: inline-block;
    font-size: 9.5px;
    letter-spacing: 0.04em;
    color: rgba(245,244,240,0.75);
    background: var(--badge);
    padding: 3px 7px;
    margin: 6px 0 10px;
  }
  .info p {
    font-size: 12px;
    line-height: 1.5;
    color: rgba(245,244,240,0.75);
    margin: 0;
  }
</style>
