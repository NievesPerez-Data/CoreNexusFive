---
// src/components/AwsInfoCTA.astro
---

<a
  href="https://docs.aws.amazon.com/es_es/AmazonS3/latest/userguide/UsingBucket.html"
  target="_blank"
  rel="noopener noreferrer"
  class="aws-cta-row"
>
  <p class="aws-cta-box">
    ↗ Información oficial de AWS
  </p>
  <svg class="aws-cta-arrow" viewBox="0 15 120 50">
    <path d="M-20,40 Q30,35 110,40" stroke="currentColor" stroke-width="7" fill="none" stroke-linecap="round"/>
    <path d="M80,18 L112,41 L80,63" stroke="currentColor" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="aws-cta-handwritten">AWS a solo un clic</span>
</a>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;700;800&display=swap');

  .aws-cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin: 24px auto 40px;
    width: fit-content;
    max-width: 100%;
    flex-wrap: nowrap;
    text-decoration: none !important;
  }
  .aws-cta-row,
  .aws-cta-row * {
    text-decoration: none !important;
  }

  .aws-cta-box {
    font-family: 'Caveat', cursive;
    font-size: 27px;
    font-weight: 700;
    color: #141312;
    line-height: 1.3;
    margin: 0;
    text-align: left;
    max-width: 460px;
    padding: 13px 16px;
    border: 1px solid rgba(17,17,17,0.14);
    background: rgba(20,19,18,0.03);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .aws-cta-row:hover .aws-cta-box {
    background: rgba(20,19,18,0.06);
    border-color: rgba(17,17,17,0.28);
  }

  .aws-cta-arrow {
    width: 60px;
    flex-shrink: 0;
    align-self: center;
    overflow: visible;
    color: #141312;
  }

  .aws-cta-handwritten {
    font-family: 'Caveat', cursive;
    font-size: 30px;
    font-weight: 700;
    color: #141312;
    line-height: 0.9;
    transform: rotate(-1deg);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .aws-cta-row { flex-direction: column; gap: 10px; width: 100%; }
    .aws-cta-arrow { display: none; }
  }
</style>
