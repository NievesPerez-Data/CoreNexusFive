---
// src/components/BucketStepsSection.astro
---

<div class="steps-timeline">
  <div class="ts-item major"><div class="ts-dot"></div><div class="ts-label"><span class="n">01</span>Crear</div></div>
  <div class="ts-item minor"><div class="ts-dot"></div><div class="ts-label"><span class="n">02</span>Control y cifrado</div></div>
  <div class="ts-item major"><div class="ts-dot"></div><div class="ts-label"><span class="n">03</span>Acceso público</div></div>
  <div class="ts-item minor"><div class="ts-dot"></div><div class="ts-label"><span class="n">04</span>Crear carpetas</div></div>
  <div class="ts-item major"><div class="ts-dot"></div><div class="ts-label"><span class="n">05</span>Crear subcarpetas</div></div>
  <div class="ts-item minor"><div class="ts-dot"></div><div class="ts-label"><span class="n">06</span>Subir archivos</div></div>
</div>

<div class="steps-grid">

  <div class="step-card secondary" data-align="right" data-shape="vert">
    <img src="/paso1.crear.png" alt="Paso 1: Crear el bucket" />
    <div class="tag"><span class="rule"></span><span class="num">01</span><span class="label">Crear</span></div>
  </div>

  <div class="step-card" data-shape="horiz">
    <img src="/paso2.control.png" alt="Paso 2: Control y cifrado" />
    <div class="tag"><span class="rule"></span><span class="num">02</span><span class="label">Control y cifrado</span></div>
  </div>

  <div class="step-card secondary" data-align="left" data-shape="vert">
    <img src="/paso3.acceso-publico.png" alt="Paso 3: Acceso público" />
    <div class="tag"><span class="rule"></span><span class="num">03</span><span class="label">Acceso público</span></div>
  </div>

  <div class="step-card" data-shape="horiz">
    <img src="/paso4.crear-carpetas.png" alt="Paso 4: Crear carpetas" />
    <div class="tag"><span class="rule"></span><span class="num">04</span><span class="label">Crear carpetas</span></div>
  </div>

  <div class="step-card secondary" data-align="right" data-shape="vert">
    <img src="/paso5.crear-carpetas.png" alt="Paso 5: Crear subcarpetas" />
    <div class="tag"><span class="rule"></span><span class="num">05</span><span class="label">Subcarpetas</span></div>
  </div>

  <div class="step-card" data-shape="horiz">
    <img src="/paso6.subir-archivos.png" alt="Paso 6: Subir archivos" />
    <div class="tag"><span class="rule"></span><span class="num">06</span><span class="label">Subir archivos</span></div>
  </div>

</div>

<a href="/about" class="demo-cta-row">
  <p class="demo-cta-box">
    ↗ Accede a la demo y sigue los pasos en vídeo.
  </p>
  <svg class="demo-marker-arrow" viewBox="0 0 120 80">
    <path d="M-20,40 Q30,35 110,40" stroke="currentColor" stroke-width="7" fill="none" stroke-linecap="round"/>
    <path d="M80,18 L112,41 L80,63" stroke="currentColor" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="demo-cta-handwritten">A un solo clic</span>
</a>

<style>
  .steps-timeline {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 90px;
    margin: 40px 0 32px;
    padding: 0 4px;
  }
  .steps-timeline::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 50%;
    height: 1px;
    background: rgba(17,17,17,0.14);
    transform: translateY(-50%);
    z-index: 0;
  }
  .ts-item {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }
  .ts-dot { width: 8px; height: 8px; border-radius: 50%; background: #6b6862; margin-bottom: 10px; }
  .ts-item.major .ts-dot { width: 14px; height: 14px; background: #141312; }
  .ts-label { font-size: 11px; line-height: 1.4; color: #6b6862; text-align: center; white-space: nowrap; }
  .ts-label .n { display: block; color: #141312; font-weight: 600; margin-bottom: 2px; }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    align-items: start;
    margin: 0 0 44px;
  }
  @media (max-width: 900px) { .steps-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .steps-grid { grid-template-columns: 1fr; } }

  .step-card {
    border: 1px solid rgba(17,17,17,0.14);
    position: relative;
    overflow: hidden;
    background: #0e0d0c;
  }
  .step-card[data-shape="vert"]  { aspect-ratio: 3 / 4.4; }
  .step-card[data-shape="horiz"] { aspect-ratio: 4 / 3; }

  .step-card.secondary { width: 66%; }
  .step-card.secondary[data-align="left"]  { margin-right: auto; }
  .step-card.secondary[data-align="right"] { margin-left: auto; }

  .step-card img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    margin: 0;
  }

  .tag {
    position: absolute;
    top: 18px; left: 18px;
    z-index: 4;
    color: #f5f4f0;
  }
  .tag .rule { display: block; width: 22px; height: 1px; background: #f5f4f0; margin-bottom: 8px; }
  .tag .num { display: block; font-size: 30px; font-weight: 600; line-height: 1; letter-spacing: -0.02em; }
  .tag .label { display: block; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(245,244,240,0.7); margin-top: 4px; }

  .demo-cta-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 48px 0 24px;
    flex-wrap: wrap;
    text-decoration: none;
  }

  .demo-cta-box {
    font-family: 'Caveat', cursive;
    font-size: 27px;
    font-weight: 700;
    color: #141312;
    line-height: 1.3;
    margin: 0;
    max-width: 460px;
    padding: 13px 16px;
    border: 1px solid rgba(17,17,17,0.14);
    background: rgba(20,19,18,0.03);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .demo-cta-row:hover .demo-cta-box {
    background: rgba(20,19,18,0.06);
    border-color: rgba(17,17,17,0.28);
  }

  .demo-marker-arrow {
    width: 60px;
    flex-shrink: 0;
    overflow: visible;
    color: #141312;
  }

  .demo-cta-handwritten {
    font-family: 'Caveat', cursive;
    font-size: 30px;
    font-weight: 700;
    color: #141312;
    line-height: 0.9;
    transform: rotate(-1deg);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .demo-cta-row { flex-direction: column; align-items: flex-start; gap: 6px; }
    .demo-marker-arrow { display: none; }
  }

  @media (max-width: 560px) {
    .steps-timeline { display: none; }
  }
</style>
