---
// src/components/BucketStepsSection.astro
const base = import.meta.env.BASE_URL.replace(/\/$/, ""); // sin barra final
---

<div class="steps-timeline">
  <div class="ts-item major"><div class="ts-dot"></div><div class="ts-label"><span class="n">01</span>Crear</div></div>
  <div class="ts-item minor"><div class="ts-dot"></div><div class="ts-label"><span class="n">02</span>Control y cifrado</div></div>
  <div class="ts-item major"><div class="ts-dot"></div><div class="ts-label"><span class="n">03</span>Acceso público</div></div>
  <div class="ts-item minor"><div class="ts-dot"></div><div class="ts-label"><span class="n">04</span>Crear carpetas</div></div>
  <div class="ts-item major"><div class="ts-dot"></div><div class="ts-label"><span class="n">05</span>Crear subcarpetas</div></div>
  <div class="ts-item minor"><div class="ts-dot"></div><div class="ts-label"><span class="n">06</span>Subir archivos</div></div>
</div>

<div class="steps-grid">

  <div class="step-card">
    <img src={`${base}/paso1.crear.png`} alt="Paso 1: Crear el bucket" />
    <div class="tag"><span class="rule"></span><span class="num">01</span><span class="label">Crear</span></div>
  </div>

  <div class="step-card">
    <img src={`${base}/paso2.control.png`} alt="Paso 2: Control y cifrado" />
    <div class="tag"><span class="rule"></span><span class="num">02</span><span class="label">Control y cifrado</span></div>
  </div>

  <div class="step-card">
    <img src={`${base}/paso3.acceso-publico.png`} alt="Paso 3: Acceso público" />
    <div class="tag"><span class="rule"></span><span class="num">03</span><span class="label">Acceso público</span></div>
  </div>

  <div class="step-card">
    <img src={`${base}/paso4.crear-carpetas.png`} alt="Paso 4: Crear carpetas" />
    <div class="tag"><span class="rule"></span><span class="num">04</span><span class="label">Crear carpetas</span></div>
  </div>

  <div class="step-card">
    <img src={`${base}/paso5.crear-carpetas.png`} alt="Paso 5: Crear subcarpetas" />
    <div class="tag"><span class="rule"></span><span class="num">05</span><span class="label">Subcarpetas</span></div>
  </div>

  <div class="step-card">
    <img src={`${base}/paso6.subir-archivos.png`} alt="Paso 6: Subir archivos" />
    <div class="tag"><span class="rule"></span><span class="num">06</span><span class="label">Subir archivos</span></div>
  </div>

</div>

<a href={`${base}/about`} class="demo-cta-row">
  <p class="demo-cta-box">
    ↗ Accede a la demo y sigue los pasos en vídeo.
  </p>
  <svg class="demo-marker-arrow" viewBox="0 15 120 50">
    <path d="M-20,40 Q30,35 110,40" stroke="currentColor" stroke-width="7" fill="none" stroke-linecap="round"/>
    <path d="M80,18 L112,41 L80,63" stroke="currentColor" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="demo-cta-handwritten">A un solo clic</span>
</a>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;700;800&display=swap');

  .steps-timeline {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 90px;
    margin: 40px 0 32px;
    padding: 0 4px;
  }
  .steps-timeline::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 50%;
    height: 1px;
    background: rgba(17,17,17,0.14);
    transform: translateY(-50%);
    z-index: 0;
  }
  .ts-item {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }
  .ts-dot { width: 8px; height: 8px; border-radius: 50%; background: #6b6862; margin-bottom: 10px; }
  .ts-item.major .ts-dot { width: 14px; height: 14px; background: #141312; }
  .ts-label { font-size: 11px; line-height: 1.4; color: #6b6862; text-align: center; white-space: nowrap; }
  .ts-label .n { display: block; color: #141312; font-weight: 600; margin-bottom: 2px; }

  /* ---- Cuadrícula: 2 columnas, se sale del ancho del texto, sin fondo ---- */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin: 0 0 48px;

    /* rompe el ancho del texto: ocupa el viewport completo, con un máximo */
    width: 100vw;
    max-width: 1400px;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    padding: 0 32px;
    box-sizing: border-box;
  }

  @media (max-width: 700px) {
    .steps-grid {
      grid-template-columns: 1fr;
      padding: 0 18px;
    }
  }

  .step-card {
    position: relative;
    border: 1px solid rgba(17,17,17,0.16);
    overflow: hidden;
    line-height: 0; /* evita el hueco bajo la imagen */
    cursor: pointer;
  }

  .step-card img {
    display: block;
    width: 100%;
    height: auto;           /* respeta las proporciones reales de cada captura */
    transition: transform 0.5s ease;
  }
  .step-card:hover img {
    transform: scale(1.05); /* zoom al pasar el cursor */
  }

  /* número en negro, directamente sobre la imagen, sin caja ni degradado */
  .tag {
    position: absolute;
    top: 14px; left: 14px;
    z-index: 2;
    color: #141312;
  }
  .tag .rule { display: block; width: 22px; height: 1px; background: #141312; margin-bottom: 8px; }
  .tag .num { display: block; font-size: 32px; font-weight: 700; line-height: 1; letter-spacing: -0.02em; }
  .tag .label { display: block; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(20,19,18,0.85); margin-top: 4px; }

  /* ---- Recuadro de la demo: centrado, sin subrayado, misma tipografía que architecture.astro ---- */
  .demo-cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin: 48px auto 24px;
    width: fit-content;
    max-width: 100%;
    flex-wrap: nowrap;
    text-decoration: none !important;
  }
  .demo-cta-row,
  .demo-cta-row * {
    text-decoration: none !important;
  }

  .demo-cta-box {
    font-family: 'Caveat', cursive;
    font-size: 27px;
    font-weight: 700;
    color: #141312;
    line-height: 1.3;
    margin: 0;
    text-align: left;
    max-width: 460px;
    padding: 13px 16px;
    border: 1px solid rgba(17,17,17,0.14);
    background: rgba(20,19,18,0.03);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .demo-cta-row:hover .demo-cta-box {
    background: rgba(20,19,18,0.06);
    border-color: rgba(17,17,17,0.28);
  }

  .demo-marker-arrow {
    width: 60px;
    flex-shrink: 0;
    align-self: center;
    overflow: visible;
    color: #141312;
  }

  .demo-cta-handwritten {
    font-family: 'Caveat', cursive;
    font-size: 30px;
    font-weight: 700;
    color: #141312;
    line-height: 0.9;
    transform: rotate(-1deg);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .demo-cta-row { flex-direction: column; gap: 10px; width: 100%; }
    .demo-marker-arrow { display: none; }
  }

  @media (max-width: 560px) {
    .steps-timeline { display: none; }
  }
</style>
